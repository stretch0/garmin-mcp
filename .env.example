# GARMIN_MCP_PUBLIC_URL=https://mini.example.ts.net
# GARMIN_MCP_GOOGLE_CLIENT_ID=
# GARMIN_MCP_GOOGLE_CLIENT_SECRET=
# GARMIN_MCP_ALLOWED_EMAILS=you@gmail.com
